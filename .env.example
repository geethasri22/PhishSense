# Backend Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=chrome-extension://*

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/phishsense
DB_HOST=localhost
DB_PORT=5432
DB_NAME=phishsense
DB_USER=postgres
DB_PASSWORD=postgres

# AI Provider Configuration (Google Gemini / OpenAI / Anthropic)
AI_PROVIDER=gemini
AI_API_KEY=your_ai_api_key_here
AI_MODEL=gemini-1.5-pro

# Threat Intelligence APIs (Optional / Future expansion)
THREAT_INTEL_API_KEY=your_threat_intel_api_key_here

# Security Secrets
JWT_SECRET=your_jwt_secret_key_here_change_in_production
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
